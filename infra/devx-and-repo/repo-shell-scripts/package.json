{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/shell-scripts",
  "version": "1.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.6.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint:precommit": "pnpm run lint",
    "lint:everything": "pnpm run lint",
    "lint": "shellcheck --source-path ../../../.githooks ./*.sh ../../../.githooks/* && prettier --check \"**/*.{sh,json,md}\"",
    "lint:everything:fix-autofixable": "prettier --write \"**/*.{sh,md,json}\""
  },
  "dependencies": {
    "cli-highlight": "^2.1.11"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-sh": "^0.14.0",
    "shellcheck": "^3.0.0"
  }
}
